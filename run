#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(realpath "$0")")"
if ! command -v dart >/dev/null 2>&1; then echo 'Dart SDK is required in PATH.' >&2; exit 127; fi
# An empty sandbox stays empty. Clone the class repository to structures/
# before creating files; starting the visualizer must never create this path.
if [[ ! -f .dart_tool/package_config.json || pubspec.yaml -nt .dart_tool/package_config.json || ( -f pubspec.lock && pubspec.lock -nt .dart_tool/package_config.json ) ]]; then
  dart pub get
fi
# Old content-addressed workers are pruned automatically when the host starts.
# To remove stale caches without starting the host, stop ./run and execute:
# dart run tool/cache_cleanup.dart
exec dart run tool/host.dart "$@"
