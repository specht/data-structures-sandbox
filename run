#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(realpath "$0")")"
if ! command -v dart >/dev/null 2>&1; then echo 'Dart SDK is required in PATH.' >&2; exit 127; fi
if [[ ! -d structures ]] || [[ -z $(find structures -type f -name '*.dart' -print -quit) ]]; then
  echo '==> No class repository found. Initializing a local example (see README for GitLab setup).'
  mkdir -p structures/example
  cp templates/example/*.dart structures/example/
fi
if [[ ! -e structures/.git ]]; then
  echo "==> Initializing a separate local Git repository under structures/"
  (cd structures && git init -q -b main)
fi
if [[ ! -f .dart_tool/package_config.json ]]; then dart pub get; fi
# Scratch files must never enter the main Git repository.
rm -rf tool/generated
rm -f tool/generated_worker_*.dart
exec dart run tool/host.dart "$@"
